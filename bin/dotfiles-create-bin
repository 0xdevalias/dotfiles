#!/usr/bin/env zsh

# TODO: add fzf mode for filename selection / previews in future

script_name=$(basename "$0")  # Using basename for script name
watch_mode=false              # Default: Do not wait for file save
save_dir="$ZSH/bin"           # Bin script save directory
new_file_input=""             # Raw --file argument
new_file=""                   # Resolved path if provided via --file
insert_snippet=true           # Default: insert template snippet

usage() {
  echo "Usage: $script_name [options]"
  echo
  echo "This script generates a new ZSH script in Sublime Text using a predefined snippet."
  echo "It opens a new Sublime Text window, inserts the snippet, sets the syntax highlighting,"
  echo "and prompts the user to save the script."
  echo
  echo "Options:"
  echo "  -f, --file <name|path>"
  echo "                      Create a script (bare names go to $save_dir), make it executable, and open in Sublime"
  echo "      --no-snippet   Do not insert the zsh snippet (still sets Bash filetype)"
  echo "  -w, --watch        Wait for the file to be saved and prompt before making it executable"
  echo "  -h, --help         Show this help message"
  echo
  echo "Mutually Exclusive Options:"
  echo "  --file and --watch cannot be used together."
  echo
  echo "Dependencies:"
  echo "  Requires Sublime Text's \`subl\` CLI and \`jq\`."
  exit 0
}

error_exit() {
  local msg="$1"
  local footer="${2:-Usage: '$script_name --help'}"

  echo ""
  echo "Error: $msg" >&2
  echo "  $footer" >&2
  echo ""
  exit 1
}

# Check for required dependencies using alternating key/value pairs
# Usage:
#   check_dependencies \
#     subl "brew install --cask sublime-text" \
#     jq   "brew install jq"
check_dependencies() {
  if (( $# == 0 )); then
    error_exit "check_dependencies requires at least one dependency pair"
  fi

  if (( $# % 2 != 0 )); then
    error_exit "check_dependencies expects key/hint pairs"
  fi

  local -A deps=("$@")
  local missing=()

  for cmd hint in "${(@kv)deps}"; do
    if ! (( $+commands[$cmd] )); then
      missing+=("$cmd (install: $hint)")
    fi
  done

  if (( ${#missing[@]} > 0 )); then
    echo ""
    echo "Error: Missing required dependencies:" >&2
    for dep in "${missing[@]}"; do
      echo "  - $dep" >&2
    done
    echo ""
    exit 1
  fi
}

# === Parse arguments ===
while [[ $# -gt 0 ]]; do
  case "$1" in
    -w|--watch)
      watch_mode=true
      shift
      ;;
    -f|--file)
      if [[ -z "$2" ]]; then
        error_exit "--file requires a path argument"
      fi
      new_file_input="$2"
      shift 2
      ;;
    --no-snippet)
      insert_snippet=false
      shift
      ;;
    -h|--help)
      usage
      ;;
    *)
      error_exit "Unknown option '$1'"
      ;;
  esac
done

# === Validation ===
if $watch_mode && [[ -n "$new_file_input" ]]; then
  error_exit "--file and --watch cannot be used together"
fi

if [[ -n "$new_file_input" ]]; then
  if [[ "$new_file_input" == */* ]]; then
    new_file="$new_file_input"
  else
    new_file="$save_dir/$new_file_input"
  fi

  save_dir_abs=${save_dir:A}
  new_file_abs=${new_file:A}

  if [[ "$new_file_abs" != "$save_dir_abs" && "$new_file_abs" != ${save_dir_abs}/* ]]; then
    echo ""
    echo "⚠️  Target path is outside $save_dir_abs: $new_file_abs"
    echo -n "Proceed anyway? [y/N] "
    if ! read -q; then
      echo ""
      error_exit "Aborting creation outside dotfiles bin" "User canceled operation"
    fi
    echo ""
  fi

  new_file="$new_file_abs"

  if [[ -e "$new_file" ]]; then
    error_exit "File already exists: $new_file"
  fi
fi

# === Dependency Checks ===
check_dependencies \
  subl "brew install --cask sublime-text" \
  jq   "brew install jq"

# Function to get a list of files in a directory, sorted by last modified time (newest first)
get_sorted_files() {
  local dir="$1"

  # ls -1t: one per line, sorted newest first
  # (@f): split output into an array (one filename per entry)
  echo "${(@f)$(ls -1t "$dir" 2>/dev/null)}"
}

# Prompt user to make file executable
prompt_make_executable() {
  local file="$1"

  if [[ ! -f "$file" ]]; then
    echo ""
    echo "⚠️  $file is not a regular file; skipping executable check."
    return
  fi

  if [[ -x "$file" ]]; then
    echo ""
    echo "ℹ️  $file is already executable."
  else
    echo ""
    echo -n "Make $file executable? [y/N] "
    if read -q; then
      chmod +x "$file"
      echo -e "\n\n✅ $file is now executable!"
    else
      echo -e "\n\nSkipping chmod +x. You can do this manually with:"
      echo "  chmod +x \"$file\""
    fi
  fi
}

# Launch Sublime
# Modes:
#   file  → open an existing file, set file type, insert snippet (optional)
#   watch → open blank, set file type, insert snippet (optional), prompt Save As
launch_sublime() {
  local mode="$1"
  local target_path="$2"

  local cmds=()
  cmds+=('{"command":"set_file_type","args":{"syntax":"Packages/ShellScript/Bash.sublime-syntax"}}')

  if $insert_snippet; then
    cmds+=('{"command":"insert_snippet","args":{"name":"Packages/User/zsh_script_template.sublime-snippet"}}')
  fi

  if [[ "$mode" == "watch" ]]; then
    cmds+=('{"command":"prompt_save_as"}')
  fi

  local chain
  chain=$(jq -cn --argjson cmds "[${(j:, :)cmds}]" '{commands:$cmds}')

  case "$mode" in
    file)
      subl --new-window --command "chain $chain" "$target_path"
      ;;
    watch)
      subl --new-window --command "chain $chain"
      ;;
    *)
      error_exit "launch_sublime invalid mode: $mode"
      ;;
  esac
}

# === File mode ===
if [[ -n "$new_file" ]]; then
  echo "Creating new script at $new_file..."
  mkdir -p "$(dirname "$new_file")"
  touch "$new_file"
  chmod +x "$new_file"

  launch_sublime file "$new_file"

  echo ""
  echo "✅ Script created at: $new_file"
  echo "   It was made executable and opened in Sublime for editing."
  exit 0
fi

# === Watch mode ===
echo "Generating a new ${ZSH}/bin script using Sublime Text ZSH template snippet"
echo "You could also do this manually by triggering the zsh_script_template snippet in Sublime."

# Capture initial file list if watching
if $watch_mode; then
  initial_files=($(get_sorted_files "$save_dir"))
fi

# Launch Sublime in 'watch' mode:
launch_sublime watch

if $watch_mode; then
  echo ""
  echo "Waiting for file to be saved in $save_dir..."

  # Monitor directory for a newly created file
  while true; do
    sleep 1
    latest_files=($(get_sorted_files "$save_dir"))

    # Find the first file that was not in the initial list
    for file in "${latest_files[@]}"; do
      if [[ ! " ${initial_files[*]} " =~ " $file " ]]; then
        new_script="$save_dir/$file"
        echo ""
        echo "Detected saved script: $new_script"
        break 2
      fi
    done
  done

  # Ask if the script should be renamed if it ends in .sh
  if [[ "$new_script" == *.sh ]]; then
    echo ""
    echo -n "The script ends in .sh. Do you want to rename it to remove the extension? [y/N] "
    if read -q; then
      new_name="${new_script%.sh}"
      mv "$new_script" "$new_name"
      new_script="$new_name"
      echo -e "\n\nScript renamed to: $new_script"
    else
      echo -e "\n\nKeeping the .sh extension."
    fi
  fi

  # Prompt to make it executable
  prompt_make_executable "$new_script"
else
  echo ""
  echo "Remember to make the script executable:"
  echo "  chmod +x <new_script_path>"
fi
