#!/usr/bin/env zsh

# Ref:
#   https://gist.github.com/0xdevalias/04ec31b12edaae727cd87d379499c14c#reading-github-notifications-from-gh-cli
#     Reading GitHub Notifications from `gh` CLI
#
# This could be potentially improved further if these issues get resolved positively:
#   https://github.com/cli/cli/issues/10261
#     Allow `--jq` and `--template` to be used together in `gh api`
#   https://github.com/cli/cli/issues/10262
#     Add custom formatting functions to `--jq` similar to those added to `--template`
#   https://github.com/cli/cli/issues/10263
#     Allow passing additional arguments through to `--jq` script, just like we can with `jq --arg`

function gh_notifications() {
  # Default values
  local DEFAULT_MODE="ungrouped"
  local DEFAULT_PARTICIPATING=false
  local DEFAULT_INCLUDE_READ=true
  local DEFAULT_SINCE=""
  local DEFAULT_BEFORE=""
  local DEFAULT_PAGE=1
  local DEFAULT_PER_PAGE=50
  local DEFAULT_PAGINATE=false

  local mode="$DEFAULT_MODE"
  local participating="$DEFAULT_PARTICIPATING"
  local include_read="$DEFAULT_INCLUDE_READ"
  local since="$DEFAULT_SINCE"
  local before="$DEFAULT_BEFORE"
  local page="$DEFAULT_PAGE"
  local per_page="$DEFAULT_PER_PAGE"
  local paginate="$DEFAULT_PAGINATE"

  local help_text="""
  Usage: gh-notifications [options]

  Options:
    -h, --help                          Show this help message and exit
    -m, --mode [grouped|ungrouped|tsv]  Set the display mode (default: $DEFAULT_MODE)
    --participating                     Show only notifications where the user is directly participating (default: $DEFAULT_PARTICIPATING)
    --include-read                      Show notifications marked as read (default: $DEFAULT_INCLUDE_READ)
    --since <ISO8601 timestamp>         Show results updated after the given time
    --before <ISO8601 timestamp>        Show results updated before the given time
    --page <number>                     The page number of results to fetch (default: $DEFAULT_PAGE)
    --per-page <number>                 Number of results per page, max 50 (default: $DEFAULT_PER_PAGE)
    --paginate                          Fetch all pages of results (overrides --page and --per-page)

  Examples:
    gh-notifications --mode grouped --include-read --since "2025-01-01T00:00:00Z"
    gh-notifications --mode ungrouped --page 2 --per-page 20
    gh-notifications --mode ungrouped --paginate
    gh-notifications --mode tsv | column -t -s $'\t'
  """

  # Parse arguments
  while [[ "$#" -gt 0 ]]; do
    case "$1" in
      -h|--help)
        echo "$help_text"
        return 0
        ;;
      -m|--mode)
        if [[ "$2" =~ ^(grouped|ungrouped|tsv)$ ]]; then
          mode="$2"
          shift
        else
          echo "Error: Invalid mode. Choose 'grouped', 'ungrouped', or 'tsv'."
          echo "$help_text"
          return 1
        fi
        ;;
      --participating)
        participating=true
        ;;
      --include-read)
        include_read=true
        ;;
      --since)
        since="$2"
        shift
        ;;
      --before)
        before="$2"
        shift
        ;;
      --page)
        if [[ "$paginate" == true ]]; then
          echo "Error: --page cannot be used with --paginate."
          echo "$help_text"
          return 1
        fi
        page="$2"
        shift
        ;;
      --per-page)
        if [[ "$paginate" == true ]]; then
          echo "Error: --per-page cannot be used with --paginate."
          echo "$help_text"
          return 1
        fi
        per_page="$2"
        shift
        ;;
      --paginate)
        if [[ "$page" -ne "$DEFAULT_PAGE" || "$per_page" -ne "$DEFAULT_PER_PAGE" ]]; then
          echo "Error: --paginate cannot be used with modified --page or --per-page options."
          echo "$help_text"
          return 1
        fi
        paginate=true
        ;;
      *)
        echo "Unknown option: $1"
        echo "$help_text"
        return 1
        ;;
    esac
    shift
  done

  local paginate_flag=""
  if [[ "$paginate" == true ]]; then
    paginate_flag="--paginate"
  fi

  # Execute the GitHub API command
  # Ref: https://docs.github.com/en/rest/activity/notifications#list-notifications-for-the-authenticated-user
  gh api notifications \
    --method GET \
    -F participating=$participating \
    -F all=$include_read \
    -F since="$since" \
    -F before="$before" \
    -F page="$page" \
    -F per_page="$per_page" \
    $paginate_flag \
    --jq "
      def timeago:
        . | fromdateiso8601 | now - . | . / 60 | floor |
        if . < 60 then
          (. | tostring + \" minutes ago\")
        elif . < 1440 then
          (. / 60 | floor | tostring + \" hours ago\")
        elif . < 43200 then
          (. / 1440 | floor | tostring + \" days ago\")
        elif . < 525600 then
          (. / 43200 | floor | tostring + \" months ago\")
        else
          (. / 525600 | floor | tostring + \" years ago\")
        end;

      def ljust(width): . + \" \" * (width - (. | length));

      def ljust_with_emoji(width):
        . as \$str |
        (\$str | gsub(\".\"; \" \") | length) as \$base_length |
        (\$str | gsub(\"[^🔴🟢🟣⚪]\"; \"\") | length * 1) as \$emoji_extra_width |
        . + \" \" * (width - \$base_length - \$emoji_extra_width);

      def api_to_web_url:
        if test(\"^https://api.github.com/repos/[^/]+/[^/]+/(issues|pulls)/[0-9]+$\") then
          sub(\"^https://api.github.com/repos/\"; \"https://github.com/\")
        elif test(\"^https://api.github.com/repos/[^/]+/[^/]+/issues/comments/[0-9]+$\") then
          capture(\"^https://api.github.com/repos/(?<repo>[^/]+/[^/]+)/issues/comments/(?<comment>[0-9]+)$\") |
          \"https://github.com/\(.repo)/issues#issuecomment-\(.comment)\"
        elif test(\"^https://api.github.com/repos/\") then
          sub(\"^https://api.github.com/repos/\"; \"https://github.com/\")
        else
          .
        end;

      def get_status:
        if .subject.type == \"Issue\" then
          if .state == \"closed\" then \"🔴 Closed\" else \"🟢 Open\" end
        elif .subject.type == \"PullRequest\" then
          if .state == \"merged\" then \"🟣 Merged\"
          elif .state == \"closed\" then \"🔴 Closed\"
          elif .draft then \"⚪ Draft\"
          else \"🟢 Open\" end
        else
          \"-\"
        end;

      def format_item:
        [
          (.repository.full_name | .[:25] | ljust(25)),
          (.subject.title | .[:50] | ljust(50)),
          (.subject.type | ljust(12)),
          (get_status | ljust_with_emoji(12)),
          (.reason | ljust(10)),
          (.updated_at | timeago | ljust(15)),
          (.subject.url | api_to_web_url)
        ] | join(\"  \");

      def format_grouped_item:
        [
          \"    \",  # Indent for grouping
          (.subject.title | .[:50] | ljust(50)),
          (.subject.type | ljust(12)),
          (get_status | ljust_with_emoji(12)),
          (.reason | ljust(10)),
          (.updated_at | timeago | ljust(15)),
          (.subject.url | api_to_web_url)
        ] | join(\"  \");

      def format_grouped_repo_header:
        .repository.html_url |
        sub(\"^https://github.com/\"; \"\") |
        \"\n\u001b[1m\u001b[36m=== \(.) ===\u001b[0m\";

      def format_tsv_item:
        [
          (.repository.full_name),
          (.subject.title),
          (.subject.type),
          (get_status),
          (.reason),
          (.updated_at | timeago),
          (.subject.url | api_to_web_url)
        ] | @tsv;

      if \"${mode}\" == \"ungrouped\" then
        .[] | format_item
      elif \"${mode}\" == \"grouped\" then
        group_by(.repository.full_name) |
        map({
          group: .,
          max_time: ([.[].updated_at | fromdateiso8601] | max)
        }) |
        sort_by(-.max_time) |
        .[].group |
        (.[0] | format_grouped_repo_header) as \$header |
        (\$header, (.[] | format_grouped_item))
      else
        .[] | format_tsv_item
      end"
}

# Check if script is executed directly
# This ensures the script behaves differently depending on how it's called.
# 1. If the script is sourced, this block will not execute, allowing you to reuse the `gh_notifications` function elsewhere.
# 2. If the script is executed directly, this block will run, passing all arguments to the function.
if [[ "${(%):-%N}" == "$0" ]]; then
  gh_notifications "$@"
fi
