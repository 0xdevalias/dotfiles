#!/usr/bin/env zsh

SCRIPT_NAME=$(basename "$0")

usage() {
  echo "Usage: $SCRIPT_NAME <repo-name> <public|private> [--description <text>]"
  echo "   or: $SCRIPT_NAME --repo <name> --visibility <public|private> [--description <text>]"
  echo ""
  echo "Create a new GitHub repository with the specified name and visibility."
  echo ""
  echo "Arguments:"
  echo "  <repo-name>           Name of the new GitHub repository."
  echo "  <public|private>      Repository visibility."
  echo ""
  echo "Options:"
  echo "  --repo <name>         Name of the new GitHub repository."
  echo "  --visibility <type>   Repository visibility ('private' or 'public')."
  echo "  --description <text>  Description of the new repository."
  echo "  -h, --help            Show this help message and exit."
  echo ""
  echo "Notes:"
  echo "  Run from a populated directory to optionally move existing files into the new repo."
  echo "  Creates a tar.gz backup only for populated in-place project initialization."
  echo "  Run from a parent directory to clone the new repo into a child directory without backing up the parent."
  echo "  If the GitHub repo already exists, prompts to clone it instead of creating it."
}

usage_hint() {
  echo "Run '$SCRIPT_NAME --help' for usage information." >&2
}

error() {
  echo "Error: $1" >&2
  usage_hint
  return 1
}

check_dependencies() {
  local missing=()
  local command_name

  for command_name in gh git jq tar npm find mv dirname basename date pwd; do
    if ! (( $+commands[$command_name] )); then
      missing+=("$command_name")
    fi
  done

  if (( ${#missing[@]} > 0 )); then
    echo "Error: Missing required dependencies:" >&2
    local missing_command
    for missing_command in "${missing[@]}"; do
      echo "  - $missing_command" >&2
    done
    return 127
  fi
}

prompt_yes_no() {
  local prompt_text="$1"
  local default_answer="${2:-}"
  local reply

  while true; do
    if [[ -t 0 ]]; then
      printf '%s ' "$prompt_text"
    else
      echo "$prompt_text"
    fi

    read -r reply

    if [[ -z "$reply" && -n "$default_answer" ]]; then
      reply="$default_answer"
    fi

    case "$reply" in
      y|Y|yes|YES)
        return 0
        ;;
      n|N|no|NO)
        return 1
        ;;
      *)
        echo "Please answer 'y' or 'n'."
        ;;
    esac
  done
}

collect_existing_items() {
  local repo_name="$1"
  collect_directory_items "." "$repo_name"
}

collect_directory_items() {
  setopt local_options null_glob

  local target_dir="$1"
  local excluded_name="${2:-}"
  local skip_git="${3:-1}"
  local item
  local -a collected_items=()

  # Reused for both "move user files" scans and "flatten the nested clone" scans.
  for item in "$target_dir"/* "$target_dir"/.[!.]* "$target_dir"/..?*; do
    [[ "$item" == "$target_dir/." || "$item" == "$target_dir/.." ]] && continue
    [[ "$skip_git" == "1" && "$item" == "$target_dir/.git" ]] && continue
    [[ -n "$excluded_name" && "$item" == "$target_dir/$excluded_name" ]] && continue
    [[ ! -e "$item" ]] && continue
    collected_items+=("$item")
  done

  if (( ${#collected_items[@]} > 0 )); then
    printf '%s\n' "${collected_items[@]}"
  fi
}

print_existing_items() {
  local project_dir="$1"
  shift
  local -a existing_items=("$@")
  local item

  if (( ${#existing_items[@]} == 0 )); then
    return 0
  fi

  echo "Detected existing files/directories in '$project_dir':"
  for item in "${existing_items[@]}"; do
    printf '  %s\n' "${item#./}"
  done
  echo ""
}

build_backup_target() {
  local project_parent="$1"
  local project_basename="$2"
  local timestamp
  local backup_target
  local backup_base
  local suffix

  timestamp=$(date +"%Y%m%d%H%M%S")
  backup_target="$project_parent/${project_basename}-pre-gh-init-$timestamp.tar.gz"

  if [[ -e "$backup_target" ]]; then
    suffix=1
    backup_base="${backup_target%.tar.gz}"
    while [[ -e "${backup_base}-$suffix.tar.gz" ]]; do
      suffix=$((suffix + 1))
    done
    backup_target="${backup_base}-$suffix.tar.gz"
  fi

  printf '%s\n' "$backup_target"
}

resolve_repo_slug_from_origin() {
  local origin_url
  local repo_slug

  if ! origin_url=$(git remote get-url origin 2>/dev/null); then
    return 1
  fi

  case "$origin_url" in
    git@*:* )
      repo_slug="${origin_url#git@*:}"
      ;;
    https://*/* )
      repo_slug="${origin_url#https://*/}"
      ;;
    http://*/* )
      repo_slug="${origin_url#http://*/}"
      ;;
    ssh://git@*/* )
      repo_slug="${origin_url#ssh://git@*/}"
      ;;
    * )
      return 1
      ;;
  esac

  repo_slug="${repo_slug%.git}"
  [[ "$repo_slug" == */* ]] || return 1

  printf '%s\n' "$repo_slug"
}

is_repo_not_found_error() {
  local output="$1"

  case "$output" in
    *"Could not resolve to a Repository"*|*"HTTP 404"*|*"Repository not found"*|*"repository not found"*)
      return 0
      ;;
    *)
      return 1
      ;;
  esac
}

move_existing_items() {
  local repo_name="$1"
  shift
  local -a existing_items=("$@")
  local -a moved_items=()
  local item
  local source_name

  if (( ${#existing_items[@]} == 0 )); then
    return 0
  fi

  if ! prompt_yes_no "Move the detected files into '$repo_name'? (y/N)" "n"; then
    echo "Leaving existing files in '$(pwd)'."
    echo ""
    return 0
  fi

  for item in "${existing_items[@]}"; do
    source_name="${item#./}"

    [[ -e "$source_name" ]] || continue

    if [[ -e "$repo_name/$source_name" ]]; then
      echo "warning: '$source_name' already exists in '$repo_name'."

      if (cd "$repo_name" && git ls-files --error-unmatch "$source_name" >/dev/null 2>&1); then
        if (cd "$repo_name" && [[ -n "$(git status --short -- "$source_name")" ]]); then
          echo "  Destination tracked but modified; skipping to avoid data loss."
          continue
        fi

        echo "  Destination tracked and clean; overwriting with existing file."
      else
        echo "  Destination not tracked; skipping."
        continue
      fi
    fi

    if ! mv "$source_name" "$repo_name/"; then
      echo "Error: failed to move '$source_name' into '$repo_name'" >&2
      return 1
    fi

    moved_items+=("$source_name")
  done

  if (( ${#moved_items[@]} > 0 )); then
    echo "Moved the following into '$repo_name':"
    for item in "${moved_items[@]}"; do
      printf '  %s\n' "$item"
    done
  else
    echo "No files moved."
  fi

  echo ""
}

flatten_nested_clone_if_safe() {
  local repo_name="$1"
  local project_dir="$2"
  local project_basename="$3"
  local nested_repo_dir="$project_dir/$repo_name"
  local item
  local source_name
  local -a remaining_items=()
  local -a nested_items=()
  local -a conflicting_items=()

  # Only flatten the common foo/foo case produced by cloning into an already-named cwd.
  [[ "$project_basename" == "$repo_name" ]] || return 0
  [[ -d "$nested_repo_dir" ]] || return 0
  [[ -d "$nested_repo_dir/.git" ]] || return 0

  # If the outer directory is already a repo, do not try to merge repo metadata.
  if [[ -e "$project_dir/.git" ]]; then
    echo "warning: '$project_dir' already contains a .git directory; leaving the clone nested."
    echo ""
    return 0
  fi

  # Flatten only when the outer directory is otherwise empty apart from the nested clone.
  while IFS= read -r item; do
    [[ -n "$item" ]] || continue
    remaining_items+=("$item")
  done < <(collect_directory_items "$project_dir" "$repo_name")

  if (( ${#remaining_items[@]} > 0 )); then
    echo "Leaving the clone nested because '$project_dir' still contains other items:"
    for item in "${remaining_items[@]}"; do
      printf '  %s\n' "${item#$project_dir/}"
    done
    echo ""
    return 0
  fi

  # The nested repo payload must include hidden entries such as .git.
  while IFS= read -r item; do
    [[ -n "$item" ]] || continue
    nested_items+=("$item")
  done < <(collect_directory_items "$nested_repo_dir" "" "0")

  if (( ${#nested_items[@]} == 0 )); then
    echo "warning: cloned repository '$nested_repo_dir' is empty; leaving it nested."
    echo ""
    return 0
  fi

  echo "Current directory name matches '$repo_name'; flattening the nested clone back into '$project_dir'."

  # Preflight collisions up front so the warning is complete and no partial move occurs.
  for item in "${nested_items[@]}"; do
    source_name="${item#$nested_repo_dir/}"

    if [[ -e "$project_dir/$source_name" ]]; then
      conflicting_items+=("$source_name")
    fi
  done

  if (( ${#conflicting_items[@]} > 0 )); then
    echo "warning: cannot flatten nested clone because these paths already exist in '$project_dir':"
    for item in "${conflicting_items[@]}"; do
      printf '  %s\n' "$item"
    done
    echo "Leaving the clone nested."
    echo ""
    return 0
  fi

  # Move only after the full preflight passes so flattening stays all-or-nothing.
  for item in "${nested_items[@]}"; do
    if ! mv "$item" "$project_dir/"; then
      echo "Error: failed to flatten '$item' into '$project_dir'" >&2
      return 1
    fi
  done

  # Remove the emptied wrapper dir.
  if ! rmdir "$nested_repo_dir"; then
    echo "Error: failed to remove now-empty directory '$nested_repo_dir'" >&2
    return 1
  fi

  echo ""
}

main() {
  set -euo pipefail

  local repo_name=""
  local visibility=""
  local description=""
  local show_help=0
  local repo_name_set_positionally=0
  local project_dir
  local project_parent
  local project_basename
  local backup_target
  local in_place_mode=0
  local backup_needed=0
  local already_cloned=0
  local local_origin_slug=""
  local remote_exists=0
  local remote_repo_output
  local remote_repo_slug=""
  local remote_repo_url=""
  local remote_repo_visibility=""
  local run_npm_init=1
  local repo_slug
  local -a existing_items=()
  local -a create_args=()
  local item

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --repo)
        if [[ $# -lt 2 ]]; then
          error "--repo requires a value"
          return 1
        fi
        if [[ -n "$repo_name" ]]; then
          error "repo name was provided more than once"
          return 1
        fi
        repo_name="$2"
        shift 2
        ;;
      --visibility)
        if [[ $# -lt 2 ]]; then
          error "--visibility requires a value ('public' or 'private')"
          return 1
        fi
        if [[ -n "$visibility" ]]; then
          error "visibility was provided more than once"
          return 1
        fi
        visibility="$2"
        shift 2
        ;;
      --description)
        if [[ $# -lt 2 ]]; then
          error "--description requires a value"
          return 1
        fi
        if [[ -n "$description" ]]; then
          error "description was provided more than once"
          return 1
        fi
        description="$2"
        shift 2
        ;;
      -h|--help)
        show_help=1
        shift
        ;;
      *)
        if [[ -z "$repo_name" ]]; then
          repo_name="$1"
          repo_name_set_positionally=1
        elif [[ -z "$visibility" ]]; then
          if (( ! repo_name_set_positionally )); then
            error "positional visibility is only allowed when the repo name is also provided positionally"
            return 1
          fi
          visibility="$1"
        else
          error "too many positional arguments: $1"
          return 1
        fi
        shift
        ;;
    esac
  done

  if (( show_help )); then
    usage
    return 0
  fi

  if [[ -z "$repo_name" ]]; then
    error "--repo is required"
    return 1
  fi

  if [[ -z "$visibility" ]]; then
    error "--visibility is required ('private' or 'public')"
    return 1
  fi

  case "$visibility" in
    private|public)
      ;;
    *)
      error "invalid visibility '$visibility' (must be 'private' or 'public')"
      return 1
      ;;
  esac

  check_dependencies || return $?

  project_dir=$(pwd)
  project_parent=$(dirname "$project_dir")
  project_basename=$(basename "$project_dir")

  if [[ "$project_basename" == "$repo_name" ]]; then
    in_place_mode=1
  elif [[ -e "$repo_name" ]]; then
    if [[ ! -d "$repo_name" ]]; then
      echo "Error: './$repo_name' already exists but is not a directory." >&2
      return 1
    fi

    echo "Found existing './$repo_name'; entering it and continuing as an in-place repo initialization."
    echo ""

    cd "$repo_name" || {
      echo "Error: failed to enter existing directory './$repo_name'" >&2
      return 1
    }

    project_dir=$(pwd)
    project_parent=$(dirname "$project_dir")
    project_basename=$(basename "$project_dir")
    in_place_mode=1
  fi

  if (( in_place_mode )); then
    while IFS= read -r item; do
      [[ -n "$item" ]] || continue
      existing_items+=("$item")
    done < <(collect_existing_items "$repo_name")
  fi

  if remote_repo_output=$(gh repo view "$repo_name" --json nameWithOwner,url,visibility 2>&1); then
    remote_exists=1
    remote_repo_slug=$(printf '%s\n' "$remote_repo_output" | jq -r '.nameWithOwner')
    remote_repo_url=$(printf '%s\n' "$remote_repo_output" | jq -r '.url')
    remote_repo_visibility=$(printf '%s\n' "$remote_repo_output" | jq -r '.visibility')
  elif is_repo_not_found_error "$remote_repo_output"; then
    remote_exists=0
  else
    echo "Error: failed to check whether GitHub repository '$repo_name' already exists." >&2
    if [[ -n "$remote_repo_output" ]]; then
      printf '%s\n' "$remote_repo_output" >&2
    fi
    return 1
  fi

  if (( in_place_mode )) && [[ -d .git ]]; then
    if local_origin_slug=$(resolve_repo_slug_from_origin); then
      if (( remote_exists )) && [[ "$local_origin_slug" == "$remote_repo_slug" ]]; then
        already_cloned=1
      elif (( remote_exists )); then
        echo "Error: '$project_dir' is already a git repository, but its origin does not match '$remote_repo_slug'." >&2
        echo "Current origin resolves to: $local_origin_slug" >&2
        return 1
      fi
    elif (( remote_exists )); then
      echo "Error: '$project_dir' is already a git repository, but its origin could not be resolved." >&2
      return 1
    fi
  fi

  if (( ${#existing_items[@]} > 0 && ! already_cloned )); then
    backup_needed=1
    backup_target=$(build_backup_target "$project_parent" "$project_basename")
  fi

  if (( remote_exists )); then
    echo "Found an existing GitHub repository for requested name '$repo_name':"
    printf '  Repository: %s\n' "$remote_repo_slug"
    printf '  URL: %s\n' "$remote_repo_url"
    printf '  Visibility: %s\n' "$remote_repo_visibility"
    echo ""
    if (( already_cloned )); then
      echo "The active project directory is already a git repository:"
      printf '  %s\n' "$project_dir"
      echo ""
      echo "No clone needed: its origin matches '$remote_repo_slug'."
    else
      echo "This will clone the existing repository instead of creating a new one."
      echo "Requested visibility, description, Node .gitignore, README, and MIT license settings will not be applied to the existing remote."
    fi
  else
    echo "This will create a new GitHub repository named '$repo_name' with '$visibility' visibility,"
    echo "configured with a Node .gitignore and MIT license."
    if [[ -n "$description" ]]; then
      echo "Description: $description"
    fi
  fi

  if (( backup_needed )); then
    echo ""
    print_existing_items "$project_dir" "${existing_items[@]}"
    echo "A tar backup of '$project_dir' will be created before cloning:"
    printf '  %s\n' "$backup_target"
  elif (( already_cloned )); then
    echo ""
    echo "No backup needed: repository is already cloned; existing files in '$project_dir' will be left untouched."
  elif (( in_place_mode )); then
    echo ""
    echo "No backup needed: no existing files were detected in '$project_dir'."
  else
    echo ""
    echo "The repository will be cloned into:"
    printf '  %s\n' "$project_dir/$repo_name"
    echo ""
    echo "No backup needed: creating a new child repo; existing files in '$project_dir' will be left untouched."
  fi
  echo ""

  if ! prompt_yes_no "Do you want to continue? (y/n)"; then
    echo "Operation cancelled."
    return 1
  fi
  echo ""

  if (( backup_needed )); then
    echo "Creating backup archive..."
    if ! tar -czf "$backup_target" -C "$project_parent" "$project_basename"; then
      echo "Error: failed to create backup archive at '$backup_target'" >&2
      return 1
    fi
    echo "Backup written to:"
    printf '  %s\n' "$backup_target"
    echo ""
  fi

  if (( already_cloned )); then
    echo "Using existing local repository..."
  elif (( remote_exists )); then
    echo "Cloning existing repo..."
    if ! gh repo clone "$remote_repo_slug"; then
      echo "Error: failed to clone existing repository '$remote_repo_slug'" >&2
      return 1
    fi
  else
    echo "Creating and cloning repo..."
    create_args=(
      "$repo_name"
      --disable-wiki
      --add-readme
      --gitignore Node
      --license MIT
      --"$visibility"
      --clone
    )

    if [[ -n "$description" ]]; then
      create_args+=(--description "$description")
    fi

    if ! gh repo create "${create_args[@]}"; then
      echo "Error: failed to create or clone repository" >&2
      return 1
    fi
  fi

  echo ""

  if (( ! already_cloned )) && [[ ! -d "$repo_name" ]]; then
    echo "Error: repository directory '$repo_name' not found after clone" >&2
    return 1
  fi

  if (( in_place_mode && ! already_cloned )); then
    move_existing_items "$repo_name" "${existing_items[@]}" || return $?
    flatten_nested_clone_if_safe "$repo_name" "$project_dir" "$project_basename" || return $?
  fi

  local repo_dir="$repo_name"
  if (( already_cloned )); then
    repo_dir="$project_dir"
  elif [[ ! -d "$repo_dir/.git" && -d "$project_dir/.git" ]]; then
    repo_dir="$project_dir"
  fi

  cd "$repo_dir" || {
    echo "Error: failed to enter repository directory '$repo_dir'" >&2
    return 1
  }

  if (( already_cloned )); then
    echo "Repository already available at:"
  else
    echo "Repository cloned to:"
  fi
  printf '  %s\n' "$(pwd)"
  echo ""

  if ! repo_slug=$(resolve_repo_slug_from_origin); then
    echo "Error: failed to resolve repository slug from git remote 'origin'" >&2
    return 1
  fi

  local set_default_output
  if ! set_default_output=$(gh repo set-default "$repo_slug" 2>&1); then
    echo "Error: failed to set default repository context" >&2
    if [[ -n "$set_default_output" ]]; then
      printf '%s\n' "$set_default_output" >&2
    fi
    return 1
  fi

  echo "Repository details:"
  gh repo view --json url,sshUrl,description | jq
  echo ""

  if [[ -e package.json ]]; then
    echo "npm package already appears initialized because package.json exists."
    if ! prompt_yes_no "Run npm init anyway? (y/N)" "n"; then
      run_npm_init=0
      echo "Skipping npm initialization."
    fi
  fi

  if (( run_npm_init )); then
    echo "Initializing npm package..."
    if ! gh init-npm; then
      echo "Error: failed to initialize npm package" >&2
      return 1
    fi
  fi

  echo ""

  echo "Opening repository in browser..."
  gh repo view --web
}

main "$@"
