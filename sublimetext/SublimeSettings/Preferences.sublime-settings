{
	"theme": "Adaptive.sublime-theme",
	"color_scheme": "Mariana.sublime-color-scheme",
	"font_size": 13,
	"dictionary": "Packages/Language - English/en_GB.dic, Packages/Language - English/en_US.dic",
	"spell_check": true,
	"ignored_packages":
	[
		"Vintage",
	],
	"word_separators": "./\\()\"':,.;<>~!@#$%^&*|+=[]{}`~?",
	"sub_word_separators": "_-",
	"copy_with_empty_selection": false,
	"default_encoding": "UTF-8",
	"drag_text": false,
	"enable_tab_scrolling": true,
	"ensure_newline_at_eof_on_save": true,
	"trim_trailing_white_space_on_save": true,
	"shift_tab_unindent": true,
	"auto_find_in_selection": false,
	"close_find_after_find_all": false,
	"close_find_after_replace_all": false,
	"highlight_modified_tabs": true,
	"scroll_past_end": true,
	"show_full_path": true,
	"show_encoding": true,
	"tab_size": 2,
	"translate_tabs_to_spaces": true,
	"index_files": true,
	"open_files_in_new_window": "finder_only",
	"focus_on_file_drop": true,

	// MarkdownEditing: https://github.com/SublimeText-Markdown/MarkdownEditing
	// Needs to be configured here as per:
	//   https://github.com/SublimeText-Markdown/MarkdownEditing/issues/667
	//   https://sublimetext-markdown.github.io/MarkdownEditing/config/#change-configuration

	// MarkdownEditing (Headings):
	"mde.detect_heading_style": false,
	"mde.match_heading_hashes": false,
	"mde.auto_match_heading_hashes": false,

	// MarkdownEditing (Lists):
	"mde.list_indent_auto_switch_bullet": false,
	"mde.list_indent_bullets": ["-"],
	"mde.auto_increment_ordered_list_number": true,
	"mde.list_align_text": false,

	// MarkdownEditing (Misc):
	"mde.auto_fold_link.enabled": false,

	// MarkdownEditing (KeyMaps):
	"mde.keymap_disable.set_heading_level": true,
	"mde.keymap_disable.reference_jump": true,
	"mde.keymap_disable.reference_new_reference": true,
	"mde.keymap_disable.reference_new_inline_link": true,
	"mde.keymap_disable.reference_new_inline_image": false,
	"mde.keymap_disable.reference_new_footnote": false,
	"mde.keymap_disable.reference_organize": true,
	"mde.keymap_disable.fold_section": true,
	"mde.keymap_disable.show_fold_all_sections": false,
	"mde.keymap_disable.goto_next_heading": false,
	"mde.keymap_disable.goto_previous_heading": false,
	"mde.keymap_disable.list_back_links": true,
	"mde.keymap_disable.open_home_page": true,
	"mde.keymap_disable.open_journal": true,
	"mde.keymap_disable.open_page": true,
	"mde.keymap_disable.make_page_reference": true,
}
