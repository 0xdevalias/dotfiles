{
  // If you want exceptions reraised so you can see them in the console, change this to true.
  "reraise_exceptions": false,

  // If you want to have a syntax applied when new files are created, set new_file_syntax to the name of the syntax
  // to use.  The format is exactly the same as "syntax" in the rules below. For example, if you want to have a new
  // file use JavaScript syntax, set new_file_syntax to 'JavaScript'.
  "new_file_syntax": "Markdown/Markdown",

  // Auto add extensions to language settings file in User folder.
  // Do not manually remove "apply_syntax_extensions" from the settings file.
  // "extenstions" are ignored by "match": "all" setting.
  "add_exts_to_lang_settings": true,

  // Control level of logging in the console.
  // (true|false|"verbose")
  "debug": false,

  // Put your custom syntax rules here:
  "syntaxes": [
    {
      // Codex rule files use Starlark and may be loaded from user, project,
      // system, or dotfiles source config layers.
      "syntax": "Starlark/starlark",
      "rules": [
        {
          "globmatch": [
            "**/.codex/rules/**/*.rules",
            "**/codex.symlink/rules/**/*.rules",
            "/etc/codex/rules/**/*.rules",
          ]
        }
      ]
    },
    {
      // This rule requires the INI plugin to be installed (via Package Control
      // or https://github.com/clintberry/sublime-text-2-ini)
      "syntax": "INI/INI",
      "rules": [
        {
          "globmatch": ["**/npmrc*"]
        }
      ]
    },
    {
      "syntax": "Markdown/Markdown",
      "rules": [
        {
          "globmatch": ["**/*.txt"]
        }
      ]
    },
    {
      "syntax": ["ShellScript/Bash", "ShellScript/Shell-Unix-Generic"],
      "rules": [
        {
          "globmatch": ["**/.dotfiles/lib/_helpers"]
        }
      ]
    },
    {
      "syntax": "Git Formats/Git Config",
      "rules": [
        {
          "globmatch": ["**/.gitconfig*", "**/gitconfig*"]
        }
      ]
    },
    {
      "syntax": "SSH Config/SSH Config",
      "rules": [
        { "globmatch": ["**/.ssh/config*", "**/ssh.symlink/config*"] }
      ]
    },
    {
      // Katai Struct: https://doc.kaitai.io/user_guide.html#_kaitai_struct_language
      "syntax": "YAML/YAML",
      "rules": [
        {
          "globmatch": ["**/*.ksy"]
        }
      ]
    },
  ]
}
