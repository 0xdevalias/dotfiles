# Ref: https://github.com/settings/tokens
HOMEBREW_GITHUB_API_TOKEN=

# Used for bin/youtube-recent-downloads, etc
export YOUTUBE_API_KEY=

# Used for ~/dev/0xdevalias/poc-chatgpt and similar OpenAI / ChatGPT things
export OPENAI_API_KEY=

# Used for ~/dev/0xdevalias/devalias.net (jekyll-github-metadata)
#   https://github.com/jekyll/github-metadata
#   https://github.com/jekyll/github-metadata/blob/main/docs/authentication.md
JEKYLL_GITHUB_TOKEN=
# OCTOKIT_ACCESS_TOKEN=

# Used for ~/.dotfiles/bin/toggl-entries and similar Toggl Track API things
#   https://engineering.toggl.com/docs/
#   https://engineering.toggl.com/docs/authentication/
export TOGGL_API_TOKEN=
export TOGGL_WORKSPACE_ID=
