# DEBUG NOTES FOR DETECTION HEURISTICS

# ⇒ git rebase main
# pre-rebase hook debug:
#   Params: main
#     1: UPSTREAM_BRANCH=main
#     2: REBASING_BRANCH=
#   TRACKING_BRANCH=origin/0xdevalias/add-nextauth-provider-azure-ad-b2c
#   CURRENT_HEAD=3079b72a717a6383275785ea26e455f4de017c5a
#   UPSTREAM_COMMIT=27cbe1c8c21f46785142fdf17cb21bac4761e2df

# ⇒ git rebase origin/main
# pre-rebase hook debug:
#   Params: origin/main
#     1: UPSTREAM_BRANCH=origin/main
#     2: REBASING_BRANCH=
#   TRACKING_BRANCH=origin/0xdevalias/add-nextauth-provider-azure-ad-b2c
#   CURRENT_HEAD=3079b72a717a6383275785ea26e455f4de017c5a
#   UPSTREAM_COMMIT=27cbe1c8c21f46785142fdf17cb21bac4761e2df

# ⇒ git rebase --onto main
# pre-rebase hook debug:
#   Params: refs/remotes/origin/0xdevalias/add-nextauth-provider-azure-ad-b2c
#     1: UPSTREAM_BRANCH=refs/remotes/origin/0xdevalias/add-nextauth-provider-azure-ad-b2c
#     2: REBASING_BRANCH=
#   TRACKING_BRANCH=origin/0xdevalias/add-nextauth-provider-azure-ad-b2c
#   CURRENT_HEAD=3079b72a717a6383275785ea26e455f4de017c5a
#   UPSTREAM_COMMIT=3079b72a717a6383275785ea26e455f4de017c5a

# ⇒ git rebase --onto origin/main
# pre-rebase hook debug:
#   Params: refs/remotes/origin/0xdevalias/add-nextauth-provider-azure-ad-b2c
#     1: UPSTREAM_BRANCH=refs/remotes/origin/0xdevalias/add-nextauth-provider-azure-ad-b2c
#     2: REBASING_BRANCH=
#   TRACKING_BRANCH=origin/0xdevalias/add-nextauth-provider-azure-ad-b2c
#   CURRENT_HEAD=3079b72a717a6383275785ea26e455f4de017c5a
#   UPSTREAM_COMMIT=3079b72a717a6383275785ea26e455f4de017c5a

# ⇒ git rebase --onto main 27cbe1c8c21f46785142fdf17cb21bac4761e2df
# pre-rebase hook debug:
#   Params: 27cbe1c8c21f46785142fdf17cb21bac4761e2df
#     1: UPSTREAM_BRANCH=27cbe1c8c21f46785142fdf17cb21bac4761e2df
#     2: REBASING_BRANCH=
#   TRACKING_BRANCH=origin/0xdevalias/add-nextauth-provider-azure-ad-b2c
#   CURRENT_HEAD=3079b72a717a6383275785ea26e455f4de017c5a
#   UPSTREAM_COMMIT=27cbe1c8c21f46785142fdf17cb21bac4761e2df

# ⇒ git rebase --onto origin/main 27cbe1c8c21f46785142fdf17cb21bac4761e2df
# pre-rebase hook debug:
#   Params: 27cbe1c8c21f46785142fdf17cb21bac4761e2df
#     1: UPSTREAM_BRANCH=27cbe1c8c21f46785142fdf17cb21bac4761e2df
#     2: REBASING_BRANCH=
#   TRACKING_BRANCH=origin/0xdevalias/add-nextauth-provider-azure-ad-b2c
#   CURRENT_HEAD=3079b72a717a6383275785ea26e455f4de017c5a
#   UPSTREAM_COMMIT=27cbe1c8c21f46785142fdf17cb21bac4761e2df

# ⇒ git rebase --onto origin/main 27cbe1c8c21f46785142fdf17cb21bac4761e2df rebase-check
# pre-rebase hook debug:
#   Params: 27cbe1c8c21f46785142fdf17cb21bac4761e2df rebase-check
#     1: UPSTREAM_BRANCH=27cbe1c8c21f46785142fdf17cb21bac4761e2df
#     2: REBASING_BRANCH=rebase-check
#   TRACKING_BRANCH=origin/0xdevalias/add-nextauth-provider-azure-ad-b2c
#   CURRENT_HEAD=3079b72a717a6383275785ea26e455f4de017c5a
